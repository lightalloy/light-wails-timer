<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="light-wails-timer"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\light-wails-timer">
    </Installer>
    <PackageInformation
        PackageName="light-wails-timer"
        PackageDisplayName="light-wails-timer"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="0.1.0.0"
        PackageDescription="Минималистичный таймер обратного отсчёта с треем и уведомлениями">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="app.lightwailstimer.timer"
                Description="Минималистичный таймер обратного отсчёта с треем и уведомлениями"
                DisplayName="light-wails-timer"
                ExecutableName="light-wails-timer"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>light-wails-timer</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>Минималистичный таймер обратного отсчёта с треем и уведомлениями</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="light-wails-timer.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
